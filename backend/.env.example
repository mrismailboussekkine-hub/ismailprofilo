DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# En local, une clé aléatoire est créée automatiquement dans .local-secret.
# En production : DEBUG=0 + clé forte + domaine HTTPS réel.
DJANGO_SECRET_KEY=
TRUST_PROXY=0
# Facultatif : les messages sont sauvegardés même sans SMTP.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
CONTACT_NOTIFY_EMAIL=
# PostgreSQL facultatif : décommenter après installation des dépendances production.
# POSTGRES_DB=portfolio
# POSTGRES_USER=portfolio
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
